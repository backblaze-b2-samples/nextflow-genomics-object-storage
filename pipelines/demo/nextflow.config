// Pipeline-level defaults for the bundled demo. The APP generates a second
// `nextflow.config` in the run's launch dir that adds the B2 `aws { … }` block
// (endpoint/region/path-style) — that one is layered on top of this at runtime.

manifest {
    name        = 'ngos-demo'
    description = 'Docker-free demo pipeline for Nextflow Genomics Object Storage'
    version     = '1.0.0'
    mainScript  = 'main.nf'
}

// Pure-Python processes: run locally, no container engine required.
process {
    executor = 'local'
    cpus     = 1
}

profiles {
    // `-profile test` is the default the app launches with: the local executor
    // and the bundled synthetic data need nothing extra.
    test {
        params.outdir = params.outdir ?: 'results'
    }
    standard {
        process.executor = 'local'
    }
}
