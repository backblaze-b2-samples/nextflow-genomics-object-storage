# Backblaze B2 (required) — S3-compatible API, standardized B2_* names.
# The S3 endpoint is derived from B2_REGION (https://s3.<B2_REGION>.backblazeb2.com),
# so there is no separate endpoint variable to keep in sync.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your-region

# Where to find these: Backblaze B2 dashboard → Application Keys (key ID +
# application key) and Buckets (bucket name + its region slug, e.g. us-west-004).
# The application key ID is a short hex string; the application key is the longer
# secret shown once at creation. Region is the bucket's slug, not a full URL.

# Optional: public bucket / CDN base for building public object URLs. Leave unset
# to use short-lived presigned download URLs (the default). No trailing slash.
# B2_PUBLIC_URL_BASE=https://cdn.example.com/my-genomics-lake

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
